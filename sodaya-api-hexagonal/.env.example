DB_DATABASE=sodaya_hexagonal
DB_USERNAME=sodaya_app
DB_PASSWORD=
DB_ADMIN_USERNAME=sodaya_owner
DB_ADMIN_PASSWORD=
DB_SSLMODE=prefer
# DB_CHARSET=utf8

QUEUE_CONNECTION=database
CACHE_STORE=database

SODAYA_DEFAULT_SODA_ID=0192f0c4-0000-7000-8000-000000000001
