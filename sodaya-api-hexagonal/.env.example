APP_NAME=SodaYa
APP_ENV=local
APP_KEY=
# APP_PREVIOUS_KEYS=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=America/Costa_Rica

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=pgsql
# DB_URL=
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=sodaya_hexagonal
DB_USERNAME=sodaya_app
DB_PASSWORD=
DB_ADMIN_USERNAME=sodaya_owner
DB_ADMIN_PASSWORD=
DB_MAINTENANCE_USERNAME=sodaya_maintenance
DB_MAINTENANCE_PASSWORD=
DB_SSLMODE=prefer
# DB_CHARSET=utf8

QUEUE_CONNECTION=database
CACHE_STORE=database

FILESYSTEM_DISK=local
MEDIA_DISK=public

DAILY_PORTIONS_RESET_AT=05:00

STRIPE_SECRET=
# STRIPE_BASE_URL=https://api.stripe.com/v1

# Canal de los avisos al cliente: log o mail
NOTICE_CHANNEL=log

MAIL_MAILER=log
MAIL_FROM_ADDRESS=avisos@sodaya.test
MAIL_FROM_NAME="${APP_NAME}"
